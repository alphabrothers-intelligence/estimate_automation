# Settings > Connect(우측 상단) > Connection String > Session pooler > URI
# (Direct connection이 아니라 Session pooler 권장 — Direct는 기본 IPv6라 일반 네트워크에서 접속 안 될 수 있음)
DATABASE_URL=postgresql://postgres.[project-ref]:[password]@[pooler-host]:5432/postgres

# Settings > API Keys > Project URL 상단 (또는 DATABASE_URL의 host에서 "db." 제거 + https:// 접두)
SUPABASE_URL=https://[project-ref].supabase.co

# Settings > API Keys > Secret keys 표 > 눈 모양 아이콘으로 전체 값 확인 (sb_secret_로 시작)
# ⚠️ RLS 우회, 서버 전용 — 절대 프론트엔드/깃허브에 노출 금지
SUPABASE_SECRET_KEY=

# console.anthropic.com > API Keys (sk-ant-로 시작) — 항목 자동생성/채팅 수정(Phase 4)에 사용
ANTHROPIC_API_KEY=
